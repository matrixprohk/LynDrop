{
  "name": "lyndrop",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "build-react": "cd client && npm run build",
    "start-server": "cd server && node index.js",
    "electron": "electron .",
    "dev": "concurrently \"npm run start-server\" \"cd client && npm run dev\"",
    "dist": "npm run build-react && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.lyndrop.app",
    "productName": "LynDrop",
    "win": {
      "target": "nsis",
      "icon": "client/public/icon-512.png"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "client/public/**/*"
    ]
  }
}
